# ==============================================================================
# CodeVoyage — Environment Configuration Template (.env.example)
# Copy this file to '.env' before starting local development or container deployment.
# NEVER commit your actual '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime Environment
# ------------------------------------------------------------------------------
# Active environment profile: 'development' or 'production'
NODE_ENV=development

# Active Spring profile: 'dev' (uses embedded H2 database) or 'docker' (uses PostgreSQL)
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# 2. Spring Boot Backend Configuration
# ------------------------------------------------------------------------------
# Port on which the Spring Boot REST API listens (Default: 8080)
BACKEND_PORT=8080
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 3. Database Configuration (Required for 'docker' profile / PostgreSQL mode)
# ------------------------------------------------------------------------------
POSTGRES_DB=codevoyage_db
POSTGRES_USER=codevoyage_admin
POSTGRES_PASSWORD=replace_with_a_secure_database_password
POSTGRES_PORT=5432

# JDBC connection string (PostgreSQL for production; H2 is used by default in 'dev' profile)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/codevoyage_db
SPRING_DATASOURCE_USERNAME=codevoyage_admin
SPRING_DATASOURCE_PASSWORD=replace_with_a_secure_database_password

# ------------------------------------------------------------------------------
# 4. Authentication & Security (JSON Web Tokens)
# ------------------------------------------------------------------------------
# Cryptographic HMAC-SHA256 signing secret key (MUST be at least 256 bits / 32 characters long)
JWT_SECRET=replace_with_a_secure_random_jwt_signing_secret_minimum_32_characters_long_2026!

# JWT Token expiration time in milliseconds (Default: 86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 5. Java Sandbox Execution Service
# ------------------------------------------------------------------------------
# URL where Spring Boot delegates Java code compilation and sandbox execution
EXECUTION_SERVICE_URL=http://localhost:5050
EXECUTION_SERVICE_PORT=5050

# Maximum execution time allowed for student-submitted Java programs in milliseconds
EXECUTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 6. React Frontend Configuration
# ------------------------------------------------------------------------------
# Development port for Vite frontend (Default: 5173)
VITE_PORT=5173

# Base URL pointing to the Spring Boot REST API
VITE_API_BASE_URL=http://localhost:8080/api/v1
